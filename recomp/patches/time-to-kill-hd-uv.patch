+static int d16_match(int bx,int by,int depth,int cx,int cy,int twin,
+                     const int *us, const int *vs) {
+    if(twin || depth > 2) return 0;
+    /* Require every vertex to lie within one non-wrapping UV rectangle.
+     * Border-crossing triangles keep PS1 sampling rather than choosing a
+     * neighbouring HD slot for the whole draw. Shader still clips per texel. */
+    float lo_u = s_puv_valid ? s_puv_u[0] : (float)us[0];
+    float hi_u = lo_u;
+    float lo_v = s_puv_valid ? s_puv_v[0] : (float)vs[0];
+    float hi_v = lo_v;
+    for(int i=1;i<3;i++) {
+        float u=s_puv_valid ? s_puv_u[i] : (float)us[i];
+        float v=s_puv_valid ? s_puv_v[i] : (float)vs[i];
+        if(u<lo_u) lo_u=u;
+        if(u>hi_u) hi_u=u;
+        if(v<lo_v) lo_v=v;
+        if(v>hi_v) hi_v=v;
+    }
+    for(unsigned slot=0;slot<s_hd.count;slot++) {
+        const TtkTextureSample *t=&s_hd.sample[slot];
+        if(depth!=(int)t->depth || bx!=(int)t->page_x || by!=(int)t->page_y ||
+           (t->palette_n&&(cx!=(int)t->cx || cy!=(int)t->cy))) continue;
+        if(!ttk_hd_uv_contains(t,lo_u,lo_v,hi_u,hi_v)) continue;
+        if(s_d16_valid[slot]<0) d16_validate(slot);
+        if(s_d16_valid[slot]) {s_d16_hits++;return (int)slot+1;}
+    }
+    return 0;
+}
  
