diff --git a/runtime/src/ttk_texture_pack.h b/runtime/src/ttk_texture_pack.h
new file mode 100644
--- a/runtime/src/ttk_texture_pack.h
+++ b/runtime/src/ttk_texture_pack.h
@@ -0,0 +1,71 @@
+/* Optional HD texture pack list for D16 exact-identity samples.
+ * TTKPACK1 (LF/CRLF) followed by 1..8 simple .ttktex filenames.
+ * No retail image bytes belong in Git. Invalid packs fail closed.
+ */
+#ifndef TTK_TEXTURE_PACK_H
+#define TTK_TEXTURE_PACK_H
+#include "ttk_texture_sample.h"
+#define TTK_HD_MAX 8
+
+typedef struct TtkHdPack {
+    TtkTextureSample sample[TTK_HD_MAX];
+    unsigned count;
+} TtkHdPack;
+
+static void ttk_hd_pack_free(TtkHdPack *pack) {
+    for (unsigned i = 0; i < pack->count; ++i)
+        ttk_texture_sample_free(&pack->sample[i]);
+    memset(pack, 0, sizeof(*pack));
+}
+
+static int ttk_hd_valid_filename(const char *name) {
+    size_t n = strlen(name);
+    if (n < 7 || n > 120 || name[0] == '.' || strcmp(name+n-7, ".ttktex")) return 0;
+    for (size_t i = 0; i < n; i++) {
+        char c = name[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+              (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.')) return 0;
+    }
+    return 1;
+}
+
+static int ttk_hd_pack_load(const char *manifest, TtkHdPack *out) {
+    TtkHdPack temp = {0};
+    char line[256], folder[1024], path[1280];
+    int ok = 0;
+    FILE *f = fopen(manifest, "rb");
+    if (!f) return 0;
+    const char *last1 = strrchr(manifest, '/'), *last2 = strrchr(manifest, '\\');
+    const char *slash = !last1 ? last2 : !last2 ? last1 : (last1 > last2 ? last1 : last2);
+    size_t prefix = slash ? (size_t)(slash - manifest + 1) : 0;
+    if (prefix >= sizeof(folder)) goto done;
+    memcpy(folder, manifest, prefix); folder[prefix] = 0;
+    if (!fgets(line, sizeof(line), f) || (strcmp(line, "TTKPACK1\n") && strcmp(line, "TTKPACK1\r\n"))) goto done;
+    while (fgets(line, sizeof(line), f)) {
+        size_t n = strlen(line);
+        if (n && line[n-1] == '\n') line[--n] = 0;
+        else if (!feof(f)) goto done; /* refuse truncated overlong line */
+        if (n && line[n-1] == '\r') line[--n] = 0;
+        if (!ttk_hd_valid_filename(line) || temp.count >= TTK_HD_MAX) goto done;
+        if (snprintf(path, sizeof(path), "%s%s", folder, line) >= (int)sizeof(path)) goto done;
+        if (!ttk_texture_sample_load(path, &temp.sample[temp.count])) goto done;
+        const TtkTextureSample *cur = &temp.sample[temp.count];
+        for (unsigned i = 0; i < temp.count; ++i) {
+            const TtkTextureSample *prev = &temp.sample[i];
+            if (prev->depth == cur->depth && prev->page_x == cur->page_x &&
+                prev->page_y == cur->page_y && prev->cx == cur->cx && prev->cy == cur->cy) {
+                ttk_texture_sample_free(&temp.sample[temp.count]); goto done;
+            }
+        }
+        ++temp.count;
+    }
+    if (ferror(f) || !temp.count) goto done;
+    *out = temp;
+    memset(&temp, 0, sizeof(temp));
+    ok = 1;
+done:
+    fclose(f);
+    ttk_hd_pack_free(&temp);
+    return ok;
+}
+#endif
